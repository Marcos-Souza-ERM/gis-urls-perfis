# Copie este arquivo para .env e ajuste os valores antes de executar.
# Caminhos relativos partem da pasta do projeto, nao da pasta do terminal.
# Caminhos Windows: use aspas SIMPLES, ex.: 'C:\Dados\Perfis\inputs'.
# Variaveis definidas no sistema/terminal tem prioridade sobre este arquivo.
# As planilhas de entrada e as pastas de saida precisam existir.

# PERFIS_RS.PY
# IMPORTANTE OBSERVAR A PARTE DO NOME DO SITE.
# Opcoes: BA, AL, AC, Tupy, RS (respeite maiusculas/minusculas).
# O site seleciona o arquivo de controle e a regra de extracao das pastas.
PERFIS_RS_SITE=BA
PERFIS_RS_INPUT_DIR=inputs
PERFIS_RS_OUTPUT_DIR=outputs
# Nome do arquivo de controle por site. JSON em uma unica linha.
# Para RS, todas as abas do controle sao concatenadas.
PERFIS_RS_CONTROL_FILES='{"BA":"BRASKEM_BA_PerfisConstrutivos_Controle.xlsx","AL":"BRASKEM_AL_PerfisConstrutivos_Controle.xlsx","AC":"ACELEN-BA Poços com perfis construtivos.xlsx","Tupy":"TupyMaua_PerfisConstrutivos_Controle.xlsx","RS":"BRK-RS-Controle perfis das locations.xlsx"}'
# Origem: PBIX/BI. Atente-se ao nome do site. {site} e substituido automaticamente.
PERFIS_RS_LINKS_FILE='perfil {site}.xlsx'
# Colunas da tabela de perfis enviada pelo GIS (disponivel no SharePoint).
# Devem ser identicas aos cabecalhos do Excel, incluindo acentos e espacos.
PERFIS_RS_LOCATION_COLUMN='ID Automação'
PERFIS_RS_SITE_COLUMN=Site
# Obrigatoria somente para RS: preencha com o cabecalho real da subarea.
PERFIS_RS_SUBAREA_COLUMN=
# Colunas da tabela que vem do BI.
PERFIS_RS_LINK_NAME_COLUMN=Name
PERFIS_RS_LINK_PATH_COLUMN='Folder Path'
# IMPORTANTE VERIFICAR O NOME DO SITE A PARTIR DO NOME DA PASTA.
# Marcadores usados nos caminhos do BI para RS e AC, respectivamente.
PERFIS_RS_RS_PATH_MARKER='Boring Logs - WebGIS'
PERFIS_RS_AC_PATH_MARKER='01. Perfis Construtivos & Sondagens/'
# Arquivos dentro da pasta de saida. Campos aceitos: {site}, {date} (AAAA-MM-DD).
PERFIS_RS_QC_FILE='QC - Encurtamento de links {site}.xlsx'
PERFIS_RS_OUTPUT_FILE='Links encurtados {site}-{date}.xlsx'

# PERFIS.PY (versao antiga; layout diferente de perfis_rs.py)
# Opcoes: BA, AL, Tupy. O valor anterior era AL.
PERFIS_SITE=AL
PERFIS_INPUT_DIR=inputs
# Antes salvava na mesma pasta das entradas; agora a pasta e configuravel.
PERFIS_OUTPUT_DIR=inputs
PERFIS_CONTROL_FILES='{"BA":"BRASKEM_BA_PerfisConstrutivos_Controle.xlsx","AL":"BRASKEM_AL_PerfisConstrutivos_Controle.xlsx","Tupy":"TupyMaua_PerfisConstrutivos_Controle.xlsx"}'
PERFIS_LINKS_FILE='perfil {site}.xlsx'
# File_Name e opcional no Excel; se ausente, usa a coluna de local abaixo.
PERFIS_FILE_COLUMN=File_Name
PERFIS_LOCATION_COLUMN=SYS_LOC_CODE
PERFIS_SITE_COLUMN=Site
# Cabecalhos usados no relatorio de pontos sem correspondencia.
PERFIS_GLOBAL_ID_COLUMN=GlobalID
PERFIS_OBJECT_ID_COLUMN=ObjectID
PERFIS_LINK_NAME_COLUMN=Name
PERFIS_LINK_PATH_COLUMN='Folder Path'
PERFIS_QC_FILE='Pontos da planilha de controle não encontrados no sharepoint.xlsx'
PERFIS_OUTPUT_FILE='Links encurtados {site}-{date}.xlsx'

# Encurtamento: o servico TinyURL recebe as URLs. Confirme autorizacao de uso.
# Falhas temporarias: espera 5s antes da segunda tentativa e 10s da terceira.
# Numeros finitos >= 0, em segundos. Usados pelos dois scripts de perfis.
LINK_RETRY_WAIT_1=5
LINK_RETRY_WAIT_2=10

# PA_CHECK.PY: comparar dois planos. Colunas identicas nos dois arquivos.
# Os arquivos abaixo nao estao disponiveis atualmente: forneca as entradas.
PA_CHECK_YAEL_FILE='inputs\Plano de Amostragem Braskem BA - Yael.xlsx'
PA_CHECK_TAISE_FILE='inputs\Plano de Amostragem Braskem BA - Taise.xlsx'
PA_CHECK_OUTPUT_FILE='Planos de amostragem.xlsx'
PA_CHECK_SITE_COLUMN=Site
PA_CHECK_POINT_COLUMN=Ponto
PA_CHECK_PARAMETER_COLUMN='Parâmetro'

